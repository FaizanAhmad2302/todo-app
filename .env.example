# Required for running the main application
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/todo_app

# Required for running the test suite
MONGODB_TEST_URI=mongodb+srv://username:password@cluster.mongodb.net/todo_app_test

# The port the HTTP server will bind to (optional, defaults to 3000)
PORT=3000

# Token Lifetimes
USER_ACCESS_TOKEN_LIFETIME=15m
ADMIN_ACCESS_TOKEN_LIFETIME=24h
REFRESH_TOKEN_LIFETIME=7d

# Swagger UI — set to "true" to enable /api-docs in development.
# Disable in production for security.
SWAGGER_ENABLED=true

# Allowed Origins (optional, defaults to http://localhost:5173 and http://localhost:3000)
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:3000