{
  "name": "todo_app",
  "version": "1.0.0",
  "description": "A comprehensive CLI and HTTP API Todo application",
  "main": "index.js",
  "bin": {
    "todo": "index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"node --watch server.js\" \"npm run dev --prefix frontend\"",
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "todo",
    "cli",
    "api",
    "mongoose"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "ms": "^2.1.3",
    "nodemailer": "^9.0.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mongodb-memory-server": "^9.1.6",
    "prettier": "^3.9.6"
  }
}
